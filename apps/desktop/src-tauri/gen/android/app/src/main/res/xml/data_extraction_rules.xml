<?xml version="1.0" encoding="utf-8"?>
<!-- Aucune sauvegarde ni transfert d'appareil : les documents restent sur le telephone. -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
  </device-transfer>
</data-extraction-rules>
