{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Droits de toutes les fenetres ForgeOffice : commandes de la coquille + boutons de la barre de titre.",
  "windows": [
    "fo-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-app-info",
    "allow-settings-load",
    "allow-settings-set",
    "allow-open-dialog",
    "allow-read-path",
    "allow-save-file",
    "allow-open-module",
    "allow-take-launch",
    "allow-recents-list",
    "allow-recents-add",
    "allow-recents-clear",
    "allow-window-set-title",
    "allow-window-set-modified",
    "allow-window-close",
    "allow-print-window",
    "allow-log-write",
    "allow-update-check",
    "allow-update-install"
  ]
}
