{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ForgeOffice",
  "mainBinaryName": "forgeoffice",
  "version": "0.5.0",
  "identifier": "org.heiphaistos.forgeoffice",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://127.0.0.1:5300",
    "beforeDevCommand": "npm run web:dev",
    "beforeBuildCommand": "npm run web:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "ForgeOffice",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false,
        "backgroundColor": "#F3F3F3"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "img-src": "'self' data: blob:",
        "media-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Heiphaistos",
    "copyright": "© 2026 Heiphaistos",
    "category": "Productivity",
    "shortDescription": "Suite bureautique : Texte, Tableur, Présentation, Publication, Base de données, PDF",
    "longDescription": "ForgeOffice est une suite bureautique complète en français : traitement de texte, tableur, présentation, publication, base de données et PDF, compatible avec les formats Office.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "docx"
        ],
        "name": "ForgeOffice.docx",
        "description": "Texte (DOCX)",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      },
      {
        "ext": [
          "docm"
        ],
        "name": "ForgeOffice.docm",
        "description": "Texte (DOCM)",
        "role": "Editor",
        "mimeType": "application/vnd.ms-word.document.macroEnabled.12"
      },
      {
