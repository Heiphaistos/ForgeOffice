{
  "name": "@forgeoffice/desktop",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "version": "0.5.4",
  "type": "module",
  "description": "Coquille Tauri 2 de ForgeOffice (Windows, Linux, macOS, Android, iOS)",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:debug": "tauri build --debug",
    "build:win64": "tauri build --target x86_64-pc-windows-msvc --bundles nsis && tauri build --target x86_64-pc-windows-msvc --bundles msi --config src-tauri/windows/msi.conf.json",
    "build:win32": "tauri build --target i686-pc-windows-msvc --bundles nsis && tauri build --target i686-pc-windows-msvc --bundles msi --config src-tauri/windows/msi.conf.json",
    "portable:win64": "tauri build --target x86_64-pc-windows-msvc --no-bundle --features portable",
    "portable:win32": "tauri build --target i686-pc-windows-msvc --no-bundle --features portable",
    "build:linux": "tauri build --bundles appimage,deb,rpm",
    "build:mac": "tauri build --target universal-apple-darwin --bundles dmg",
    "icon": "tauri icon icon.svg -o src-tauri/icons",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk --aab",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check:win32": "cargo check --manifest-path src-tauri/Cargo.toml --target i686-pc-windows-msvc",
    "check:android": "cargo check --manifest-path src-tauri/Cargo.toml --target aarch64-linux-android",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "web:dev": "cd ../.. && npm run dev -w apps/web -- --port 5300 --strictPort",
    "web:build": "cd ../.. && npm run build -w apps/web",
    "associations": "node scripts/associations.mjs"
  }
}
