{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Droits de toutes les fenetres ForgeOffice : commandes de la coquille + boutons de la barre de titre.",
  "windows": [
    "fo-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-app-info",
    "allow-settings-load",
    "allow-settings-set",
    "allow-open-dialog",
    "allow-read-path",
    "allow-save-file",
    "allow-open-module",
    "allow-take-launch",
    "allow-recents-list",
    "allow-recents-add",
    "allow-recents-clear",
    "allow-window-set-title",
    "allow-window-set-modified",
    "allow-window-close",
    "allow-print-window",
    "allow-log-write",
    "allow-update-check",
    "allow-update-install",
    "allow-base-open",
    "allow-base-create",
    "allow-base-copy",
    "allow-base-close",
    "allow-base-op",
    "allow-convert-capacites",
    "allow-convert-run",
    "allow-convert-run-bytes",
    "allow-convert-pick-folder",
    "allow-convert-miniatures",
    "allow-convert-save-into",
    "allow-inbox-take",
    "allow-share-file",
    "allow-set-immersive",
    "allow-set-system-bars",
    "allow-exit-app",
    "allow-folder-pick",
    "allow-folder-list",
    "allow-folder-read",
    "allow-folder-write",
    "allow-folder-mkdir",
    "allow-folder-rename",
    "allow-folder-copy",
    "allow-folder-exists",
    "allow-folder-trash",
    "allow-file-info",
    "allow-reveal-in-folder",
    "core:window:allow-set-always-on-top"
  ]
}
