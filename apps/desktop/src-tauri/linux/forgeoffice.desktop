[Desktop Entry]
{{#if categories}}
Categories={{categories}}
{{/if}}
{{#if comment}}
Comment={{comment}}
{{/if}}
# %F : sans lui, « Ouvrir avec ForgeOffice » du gestionnaire de fichiers lance l'appli sans le document.
Exec={{exec}} %F
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
{{#if mime_type}}
MimeType={{mime_type}}
{{/if}}
